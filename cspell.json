{
    "allowCompoundWords": true,
    "dictionaryDefinitions": [
        { "name": "telemac", "path": "tools/dict/telemac.txt" },
        { "name": "free-surface", "path": "tools/dict/free-surface.txt" },
        { "name": "rust", "path": "tools/dict/rust.txt" }
    ],
    "dictionaries": ["telemac", "free-surface"],
    "languageSettings": [
        { "languageId": "Rust", "dictionaries": ["rust"] }
    ],
    "overrides": [
        // Don't check spelling on the dico themself!
        {
            "filename": "tools/dict/*.txt",
            "enabled": false
        },
        // Packages names in Cargo.toml often hurt CSpell
        // They are ignored in "rust" dictionary
        {
            "filename": "Cargo.toml",
            "dictionaries": ["rust"]
        }
    ]
}
