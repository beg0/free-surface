# Messages pour l'enum ParseError

cas-parse-diag-read-file-failure = Impossible de lire le fichier : {$error}.
cas-parse-diag-unknown-key = Clé inconnue : « {$key} ».
cas-parse-diag-invalid-value = Valeur invalide pour la clé « {$key} » : {$reason}.
cas-parse-diag-out-of-bound = Valeur hors limites pour la clé {$key} : la valeur doit être comprise entre {$min} et {$max}, reçu « {$value} ».
cas-parse-diag-bad-choice = Valeur invalide pour la clé {$key} : {$reason}.
