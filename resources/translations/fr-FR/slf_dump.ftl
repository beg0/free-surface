slf-dump-diagnostic-missing-show-option = rien à afficher — utilisez --show et/ou --history
slf-dump-diagnostic-run-help = exécutez avec --help pour afficher l’aide
slf-dump-diagnostic-file-parsing-failure = échec de l’analyse du fichier : {$error}
slf-dump-diagnostic-time-index-out-of-range = indice temporel {$time} hors limites (le fichier contient {$step_count} temps)
slf-dump-diagnostic-no-such-variable = variable « {$variable} » introuvable dans le fichier
slf-dump-diagnostic-available-variables = variables disponibles :
  { $variables }
slf-dump-diagnostic-no-such-layer = la couche n°{$requested} n’existe pas (le fichier contient {$actual} {
    $actual ->
    [one] couche
    *[other] couches
})
