# Messages pour ConfigValue

config-value-invalid-bool = '{$value}' n'est pas un booléen valide
config-value-invalid-integer = '{$value}' n'est pas un entier valide : {$reason}
config-value-invalid-real = '{$value}' n'est pas un nombre flottant valide : {$reason}

config-value-invalid-type = l'élément {$index} n'est pas un {$expectedType} : {$actualType}
config-value-unimplemented-collection = impossible de collecter un vecteur de {$actualType}
config-value-not-a-collection = {$type} n'est pas une variante de collection
config-value-collect-empty-vec = impossible de collecter un vecteur vide
