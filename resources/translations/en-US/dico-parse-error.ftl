# Messages for DicoParseError

dico-parse-error-read-file-failure = Can't read file: {$error}.
dico-parse-error-missing-field = Missing required field '{$field}' in keyword block.
dico-parse-error-unknown-field = Unknown field '{$field}'.
dico-parse-error-invalid-value = Invalid value for field '{$field}': {$reason}.
dico-parse-error-too-many-values = Too many values for field '{$field}': got {$got_count} but expected {$expected_count}.
dico-parse-error-not-enough-values = Not enough values for field '{$field}': got {$got_count} but expected at least {$expected_count}.
dico-parse-error-invalid-default-value = Invalid default value '{$value}' in field {$field}: {$reason}.
# dico-parse-error-duplicated-key = Duplicated field {$field} in block starting at {$block_pos}.
# dico-parse-error-inconsistent-default-values = Inconsistent default values.
dico-parse-error-invalid-choice = Invalid value for choice '{$option}' in field {$field}: {$reason}.
# dico-parse-error-inconsistent-choice-option  = Inconsistent options between choices for {$lang1} and {$lang2}. Got {$choices1} and {$choices2}.
dico-parse-error-inconsistent-choice-option = Inconsistent options between choices for different languages. Got {$cnt1} and {$cnt2} options..
