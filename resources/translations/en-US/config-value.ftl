# Messages for ConfigValue

config-value-invalid-bool = '{$value}' is not a valid boolean
config-value-invalid-integer = '{$value}' is not a valid integer: {$reason}
config-value-invalid-real = '{$value}' is not a valid float: {$reason}

config-value-invalid-type = element {$index} is not a {$expectedType}: {$actualType}
config-value-unimplemented-collection = cannot collect a Vec of {$actualType}
config-value-not-a-collection = {$type} is not a collection variant
config-value-collect-empty-vec = cannot collect an empty Vec
